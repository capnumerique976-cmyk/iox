# ─────────────────────────────────────────────────────────────
#  IOX — Variables d'environnement PILOTE
#  Copier → .env puis renseigner toutes les valeurs.
#  JAMAIS committer ce fichier avec de vraies valeurs.
# ─────────────────────────────────────────────────────────────

# ── Domaine ───────────────────────────────────────────────────
FRONTEND_URL=https://iox.mycloud.yt
FRONTEND_URLS=https://iox.mycloud.yt
NEXT_PUBLIC_SITE_URL=https://iox.mycloud.yt
NEXT_PUBLIC_API_URL=https://iox.mycloud.yt/api/v1

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=iox
POSTGRES_PASSWORD=CHANGE_ME_strong_pg_password_32chars
POSTGRES_DB=iox_pilot

# ── Redis ─────────────────────────────────────────────────────
# Pas de variable nécessaire — URL construite automatiquement.

# ── MinIO (stockage médias marketplace) ───────────────────────
MINIO_ROOT_USER=iox_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password_32chars
MINIO_BUCKET=iox-pilot
# Laisser vide pour URLs signées internes (recommandé pilote).
MINIO_PUBLIC_URL=

# ── JWT secrets ───────────────────────────────────────────────
# Générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_jwt_secret_minimum_64_hex_chars_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_minimum_64_hex_chars_bbbbbbbbbbbbbbbbbbbbbbbbbbbb

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Email transactionnel (Resend) ────────────────────────────
# https://resend.com — compte gratuit 3000 emails/mois
# Laisser vide pour désactiver l'envoi d'emails (mode pilote initial).
RESEND_API_KEY=

# ── Stripe (paiements) ────────────────────────────────────────
# Laisser vide pour pilote sans paiements réels.
# Pour activer : renseigner les clés LIVE (pas test).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Monitoring ────────────────────────────────────────────────
# Token pour /metrics endpoint (laisser vide = endpoint désactivé).
METRICS_TOKEN=
